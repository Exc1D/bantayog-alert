{
  "name": "@bantayog/e2e-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:staging": "playwright test --config=playwright.staging.config.ts",
    "proof:local": "BANTAYOG_PROOF_TARGET=local playwright test specs/full-loop.spec.ts",
    "proof:staging": "BANTAYOG_PROOF_TARGET=staging playwright test --config=playwright.staging.config.ts specs/full-loop.spec.ts",
    "seed:accounts": "npx tsx fixtures/admin-seed.ts && npx tsx fixtures/responder-seed.ts",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "firebase-admin": "^14.1.0",
    "typescript": "^6.0.3"
  }
}
