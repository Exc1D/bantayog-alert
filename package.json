{
  "name": "bantayog-alert",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev-all.mjs",
    "dev:apps": "turbo run dev",
    "dev:all": "node scripts/dev-all.mjs",
    "demo:seed": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8081 tsx scripts/seed-staging-incidents.ts",
    "demo:reset": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8081 tsx scripts/seed-staging-incidents.ts --reset-only",
    "demo:reseed": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8081 tsx scripts/seed-staging-incidents.ts --reset",
    "proof:mvp-loop": "firebase emulators:exec --only firestore,database 'pnpm --dir functions exec vitest run src/__tests__/proof-mvp-loop.test.ts'",
    "proof:local": "node scripts/proof-local.mjs",
    "staging:seed": "tsx scripts/staging-seed.ts",
    "staging:reset": "tsx scripts/staging-reset.ts",
    "staging:smoke-proof": "tsx scripts/staging-smoke-proof.ts",
    "staging:e2e-proof": "tsx scripts/staging-e2e-proof.ts",
    "staging:callable-proof": "tsx scripts/staging-callable-proof.ts",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:rules": "turbo run test:rules",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "emulators": "firebase emulators:start",
    "load-test": "node e2e-tests/k6/run.cjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@bantayog/shared-validators": "workspace:*",
    "@eslint/js": "^9.12.0",
    "@types/node": "^20.12.0",
    "@vitest/coverage-v8": "^4.1.7",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.6",
    "lint-staged": "^16.4.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "turbo": "^2.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@turf/turf": "^7.3.5",
    "@types/geojson": "^7946.0.16",
    "geojson": "^0.5.0",
    "ngeohash": "^0.6.3"
  },
  "pnpm": {
    "overrides": {
      "@firebase/rules-unit-testing>firebase": "12.13.0"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "firebase"
      ],
      "allowedVersions": {
        "@firebase/rules-unit-testing>firebase": "^12.13.0 || ^12.14.0"
      }
    }
  }
}
